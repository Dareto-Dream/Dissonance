<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 
                             http://lime.openfl.org/xsd/project-1.0.4.xsd">

    <!-- _________________________ Application Settings _________________________ -->

    <app title="Dissonance"
         file="Dissonance"
         main="Main"
         version="0.0.1"
         company="HaxeFlixel" />

    <!-- Use Flixel's preloader -->
    <app preloader="flixel.system.FlxPreloader" />

    <!-- SWF version (ignored on HTML5 but required for builds) -->
    <set name="SWF_VERSION" value="11.8" />


    <!-- ____________________________ Window Settings ___________________________ -->

    <!-- Default resolution for ALL platforms (desktop + html5 fallback) -->
    <window width="1280"
            height="720"
            fps="60"
            background="#000000"
            hardware="true"
            vsync="false" />

    <!-- HTML5-specific high-quality rendering -->
    <window if="html5"
            width="1280"
            height="720"
            resizable="true"
            allow-high-dpi="true" />

    <!-- Desktop -->
    <window if="desktop"
            width="1280"
            height="720"
            orientation="landscape"
            fullscreen="false"
            resizable="true" />

    <!-- Mobile -->
    <window if="mobile"
            orientation="landscape"
            fullscreen="true"
            width="0"
            height="0"
            allow-high-dpi="true" />



    <!-- _____________________________ Path Settings ____________________________ -->

    <set name="BUILD_DIR" value="export" />
    <source path="source" />
    <assets path="assets" />


    <!-- _______________________________ Libraries ______________________________ -->

    <haxelib name="flixel" />

    <!-- Uncomment if needed -->
    <!-- <haxelib name="flixel-addons" /> -->
    <!-- <haxelib name="flixel-ui" /> -->
    <!-- <haxelib name="nape-haxe4" /> -->


    <!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_HEALTH" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<haxedef name="FLX_NO_MOUSE" if="mobile" />
	<haxedef name="FLX_NO_KEYBOARD" if="mobile" />
	<haxedef name="FLX_NO_TOUCH" if="desktop" />

	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<haxedef name="message.reporting" value="pretty" />



    <!-- _________________________________ Custom _______________________________ -->

    <!-- Add custom icons, android settings, etc., here -->

</project>
