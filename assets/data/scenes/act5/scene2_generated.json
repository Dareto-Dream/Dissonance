    },
    {
      "id": "n3",
      "type": "narration",
      "text": "The largest room in the music wing. Chairs are arranged in rows. An audience is forming — classmates, teachers, even the principal near the back.",
      "next": "n4"
    },
    {
      "id": "n4",
      "type": "narration",
      "text": "This isn't about saving the club anymore. This is about what the music means.",
      "next": "n5"
    },
    {
      "id": "n5",
      "type": "narration",
      "text": "Backstage — if you can call a corner behind a curtain \"backstage\" — everyone is preparing.",
      "next": "n6"
    },
    {
      "id": "n6",
      "type": "if",
      "condition": "tiffany_rot <= 0",
      "trueNode": "n7_tiffany_broken",
      "falseNode": "n7_tiffany_calm"
    },
    {
      "id": "n7_tiffany_broken",
      "type": "action",
