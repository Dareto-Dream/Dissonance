      "next": "n8_tiffany_broken"
    },
    {
      "id": "n8_tiffany_broken",
      "type": "dialogue",
      "speaker": "Tiffany",
      "character": "tiffany",
      "pose": "broken_blood",
      "text": "One last time. Let's... let's make it beautiful.",
      "text_effect": "glitch",
      "effect_intensity": 1.5,
      "next": "n9_converge_tiffany"
    },
    {
      "id": "n7_tiffany_calm",
      "type": "action",
