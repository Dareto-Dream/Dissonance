      "action": "hide_character",
      "character": "cassian",
      "transition": "fade_out",
      "duration": 0.3,
      "next": "n_ec17"
    },
    {
      "id": "n_ec17",
      "type": "action",
      "action": "hide_character",
      "character": "laura",
      "transition": "fade_out",
      "duration": 0.3,
      "next": "n_ec18"
    },
    {
      "id": "n_ec18",
      "type": "action",
      "action": "set_bg",
      "background": "assets/images/bg/streetnight.png",
      "transition": "fade",
      "duration": 1.0,
      "next": "n_ec19"
    },
    {
      "id": "n_ec19",
      "type": "narration",
      "text": "Some songs don't have happy endings. But they're still worth playing.",
      "next": "n_ending_title"
    },
    {
