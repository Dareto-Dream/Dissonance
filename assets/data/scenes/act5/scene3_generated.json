      "next": "n_title_text"
    },
    {
      "id": "n_title_text",
      "type": "narration",
      "text": "DISSONANCE",
      "text_effect": "typewriter",
      "effect_speed": 3.0,
      "next": "n_thanks"
    },
    {
      "id": "n_thanks",
      "type": "narration",
      "text": "Thank you for playing.",
      "next": "final_end"
    },
    {
